[Unit]
Description=nxbt-orchestrator (Bluetooth controller server for nxml)
After=bluetooth.service network.target
Requires=bluetooth.service

[Service]
# READY=1 is sd_notified once the API is serving; the Switch connects in the
# background and /health reports switch_state.
Type=notify
NotifyAccess=main
# nxbt requires root to open the BlueZ HCI socket.
User=root
ExecStart=/usr/local/bin/nxbt-orchestrator serve --host 127.0.0.1 --port 7777
Restart=on-failure
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=20
KillMode=mixed

[Install]
WantedBy=multi-user.target
