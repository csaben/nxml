#!/usr/bin/env bash
set -Eeuo pipefail
umask 027

CONTROL=nxml-control.service
INFERENCE=nxml-inference.service
ENV_FILE=/etc/nxml-control/nxml-control.env
TOKEN_FILE=/etc/nxml-control/token
REPO=/opt/nxml
CONTROL_URL=http://100.80.98.4:8787
INFERENCE_ENDPOINT=tcp://100.80.98.4:5557
DATASET=nxml-pokemon-za-v2
PAUSE_STATE=/run/nxml-stack-paused-vllm-qwen
ACTION=${1:-status}
shift || true
STOP_MANAGED_VLLM=0

for arg in "$@"; do
  case "$arg" in
    --stop-managed-vllm) STOP_MANAGED_VLLM=1 ;;
    *) printf '[nxml-stack] ERROR: unknown option: %s\n' "$arg" >&2; exit 2 ;;
  esac
done

log() { printf '[nxml-stack] %s\n' "$*"; }
die() { log "ERROR: $*" >&2; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || die "$ACTION requires sudo"; }
active() { systemctl is-active --quiet "$1"; }

token_python() {
  "$REPO/.venv/bin/python" - "$@" <<'PY'
import json, os, sys, urllib.request
path = sys.argv[1]
token = open("/etc/nxml-control/token", encoding="utf-8").read().strip()
request = urllib.request.Request(
    "http://100.80.98.4:8787" + path,
    headers={"Authorization": "Bearer " + token},
)
with urllib.request.urlopen(request, timeout=5) as response:
    print(json.dumps(json.load(response), sort_keys=True))
PY
}

inference_info() {
  "$REPO/.venv/bin/python" - <<'PY'
import json, zmq
context = zmq.Context()
socket = context.socket(zmq.REQ)
socket.setsockopt(zmq.LINGER, 0)
socket.setsockopt(zmq.RCVTIMEO, 1500)
socket.setsockopt(zmq.SNDTIMEO, 1500)
socket.connect("tcp://100.80.98.4:5557")
try:
    socket.send(bytes([0x14]))
    info = json.loads(socket.recv())
    safe = {key: info.get(key) for key in (
        "ready", "state", "revision_id", "checkpoint_sha256", "action_spec_id",
        "action_dim", "device",
    )}
    print(json.dumps(safe, sort_keys=True))
    if info.get("ready") is not True or not info.get("revision_id") or not info.get("checkpoint_sha256"):
        raise SystemExit(1)
finally:
    socket.close()
    context.term()
PY
}

worker_capability() {
  [[ -x "$REPO/.venv/bin/nxml-bc-worker" ]] || return 1
  [[ -r $ENV_FILE ]] || return 2
  grep -q '^NXML_BC_WORKER_COMMAND=.*nxml-bc-worker' "$ENV_FILE"
}

gpu0_conflicts() {
  local gpu_uuid inference_pid
  gpu_uuid=$(nvidia-smi --query-gpu=index,uuid --format=csv,noheader,nounits |
    awk -F', *' '$1==0 {print $2}')
  inference_pid=$(systemctl show "$INFERENCE" -p MainPID --value 2>/dev/null || true)
  nvidia-smi --query-compute-apps=pid,gpu_uuid,name --format=csv,noheader,nounits |
    awk -F', *' -v gpu="$gpu_uuid" -v keep="$inference_pid" '$2==gpu && $1!=keep {print $1 " " $3}'
}

verify() {
  active "$CONTROL" || die "$CONTROL is not active"
  active "$INFERENCE" || die "$INFERENCE is not active"
  curl --fail --silent --show-error "$CONTROL_URL/healthz" >/dev/null
  local storage info
  storage=$(token_python "/v1/datasets/$DATASET/segment-status")
  "$REPO/.venv/bin/python" -c 'import json,sys; x=json.loads(sys.argv[1]); assert x["ingest_admission"]["state"]=="admitting"; assert x["schema_id"]=="nxml.segment-status.v1"' "$storage"
  worker_capability || die "real BC worker is not configured"
  info=$(inference_info) || die "inference is not digest-bound ready"
  log "control=$CONTROL_URL health=ready"
  log "storage=$CONTROL_URL/v1/datasets/$DATASET/segment-status admission=admitting"
  log "training=enabled worker=nxml-bc-worker (no job submitted)"
  log "inference=$INFERENCE_ENDPOINT identity=$info"
  log "AI arm was not changed"
}

status() {
  log "$CONTROL $(systemctl is-active "$CONTROL" 2>/dev/null || true)"
  log "$INFERENCE $(systemctl is-active "$INFERENCE" 2>/dev/null || true)"
  if active "$CONTROL"; then
    curl --fail --silent --show-error "$CONTROL_URL/healthz" || true
    printf '\n'
    if [[ -r $TOKEN_FILE ]]; then
      token_python "/v1/datasets/$DATASET/segment-status" || true
    else
      log "authenticated storage status unavailable to this user"
    fi
  fi
  if active "$INFERENCE"; then inference_info || true; fi
  if worker_capability; then
    log "training worker capability: configured"
  elif [[ $? -eq 2 ]]; then
    log "training worker capability: configuration readable only under sudo; executable present"
  else
    log "training worker capability: unavailable"
  fi
  log "control=$CONTROL_URL inference=$INFERENCE_ENDPOINT"
}

start_stack() {
  need_root
  [[ -r $ENV_FILE && -r $TOKEN_FILE ]] || die "NXML configuration/token is unavailable"
  [[ -x $REPO/.venv/bin/nxml-control && -x $REPO/.venv/bin/nxml-inference ]] || die "NXML deployment is incomplete"
  worker_capability || die "real BC worker must be configured before start"
  if active "$CONTROL" && active "$INFERENCE"; then
    log "NXML services are already active; verifying without disturbing GPU workloads"
    verify
    return
  fi
  local conflicts vllm_running=0
  conflicts=$(gpu0_conflicts || true)
  if docker inspect -f '{{.State.Running}}' vllm-qwen 2>/dev/null | grep -qx true; then
    vllm_running=1
  fi
  if [[ -n $conflicts ]]; then
    if [[ $STOP_MANAGED_VLLM -eq 1 && $vllm_running -eq 1 ]]; then
      log "stopping explicitly selected managed GPU0 conflict docker/vllm-qwen"
      docker stop vllm-qwen >/dev/null
      install -m 0600 /dev/null "$PAUSE_STATE"
      conflicts=$(gpu0_conflicts || true)
    fi
    [[ -z $conflicts ]] || die "unmanaged GPU0 processes remain; refusing to stop them: $conflicts"
  fi
  local control_was=0 inference_was=0 success=0
  active "$CONTROL" && control_was=1
  active "$INFERENCE" && inference_was=1
  rollback() {
    local rc=$?
    [[ $success -eq 1 ]] && return
    log "start failed; restoring prior service state"
    [[ $inference_was -eq 1 ]] || systemctl stop "$INFERENCE" >/dev/null 2>&1 || true
    [[ $control_was -eq 1 ]] || systemctl stop "$CONTROL" >/dev/null 2>&1 || true
    if [[ -f $PAUSE_STATE ]]; then docker start vllm-qwen >/dev/null 2>&1 || true; rm -f "$PAUSE_STATE"; fi
    exit "$rc"
  }
  trap rollback ERR INT TERM
  systemctl start "$CONTROL"
  systemctl start "$INFERENCE"
  verify
  success=1
  trap - ERR INT TERM
}

stop_stack() {
  need_root
  systemctl stop "$INFERENCE"
  systemctl stop "$CONTROL"
  if [[ -f $PAUSE_STATE ]]; then
    log "restoring managed GPU0 workload docker/vllm-qwen"
    docker start vllm-qwen >/dev/null
    rm -f "$PAUSE_STATE"
  fi
  log "NXML endpoints stopped; GPU1 and unrelated workloads were untouched"
}

case "$ACTION" in
  status) status ;;
  dry-run)
    log "would start $CONTROL then $INFERENCE; verify storage admission, BC worker, and digest-bound INFO"
    log "GPU0 conflicts:"
    gpu0_conflicts || true
    log "no process, service, model deployment, training job, or AI arm changed"
    ;;
  start) start_stack ;;
  restart) need_root; systemctl restart "$CONTROL"; systemctl restart "$INFERENCE"; verify ;;
  stop) stop_stack ;;
  verify) verify ;;
  *) die "usage: $0 {status|dry-run|start|verify|restart|stop} [--stop-managed-vllm]" ;;
esac
