# No token value belongs in this file. The referenced file must be owned by
# nxml-control and mode 0600.
NXML_CONTROL_TOKEN_FILE=/etc/nxml-control/token

# Optional until training is enabled. This workspace-installed command implements
# TRAINING_WORKER.md and pins all encoding/training work to physical GPU 0.
NXML_BC_WORKER_COMMAND=/usr/bin/env CUDA_VISIBLE_DEVICES=0 HF_HOME=/var/lib/nxml-control/hf /opt/nxml/.venv/bin/nxml-bc-worker --state-dir /var/lib/nxml-control --checkpoint-dir /var/lib/nxml-control/checkpoints

# Immutable registry revision loaded by the separately managed GPU data plane.
# This is an ID, never a checkpoint path. Change it only after validation.
NXML_INFERENCE_REVISION_ID=2f772838-2179-4739-a53c-aa95dcea35a0
