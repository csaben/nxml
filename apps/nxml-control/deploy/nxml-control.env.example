# No token value belongs in this file. The referenced file must be owned by
# nxml-control and mode 0600.
NXML_CONTROL_TOKEN_FILE=/etc/nxml-control/token

# Required in production. Install this executable separately; it must implement
# TRAINING_WORKER.md. Do not point production at a fake/smoke worker.
# NXML_BC_WORKER_COMMAND=/opt/nxml-worker/bin/nxml-bc-worker
