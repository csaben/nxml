[Unit]
Description=NXML edge supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Code/nxml
ExecStart=%h/.local/bin/uv --directory %h/Code/nxml run nxml-edge --config %h/.config/nxml/edge.json --token-file %h/.config/nxml/autopilot.token
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/nxml %h/.local/state/nxml-edge

[Install]
WantedBy=default.target
