[Unit]
Description=NXML autopilot edge runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/nxml/cradle.env
WorkingDirectory=%h/Code/nxml
ExecStart=%h/Code/nxml/deploy/cradle-ns/run-autopilot.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=true

[Install]
WantedBy=default.target
